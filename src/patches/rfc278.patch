+            <td align="left" colspan="1" rowspan="1">09</td>
+            <td align="left" colspan="1" rowspan="1">011</td>
+            <td align="left" colspan="1" rowspan="1">Error or unsuccessful terminate</td>
+          </tr>
+          <tr>
+            <td align="left" colspan="1" rowspan="1">0A</td>
