<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="std" docName="draft-ietf-fax-faxservice-enum-03" indexInclude="true" number="4143" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
