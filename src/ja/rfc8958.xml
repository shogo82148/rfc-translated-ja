  <front>
    <title abbrev="Updated Registration Rules for URI.ARPA">URI.ARPAの更新された登録規則</title>
    <seriesInfo name="RFC" value="8958" stream="IETF"/>
    <seriesInfo name="BCP" value="65" stream="IETF"/>
    <author fullname="Ted Hardie" surname="Hardie">
