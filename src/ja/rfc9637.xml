    <title abbrev="Expanding the IPv6 Documentation Space">IPv6ドキュメンテーション用アドレス空間の拡張</title>
    <seriesInfo name="RFC" value="9637" stream="IETF"/>
    <author initials="G." surname="Huston" fullname="Geoff Huston">
