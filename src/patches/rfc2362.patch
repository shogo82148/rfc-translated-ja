+            <tr>
+              <td align="left" colspan="1" rowspan="1">Border</td>
+              <td align="left" colspan="1" rowspan="1">Register</td>
+              <td align="left" colspan="1" rowspan="1">Register for external sources is coming from PIM multicast  border  router</td>
+            </tr>
+            <tr>
+              <td align="left" colspan="1" rowspan="1">Null</td>
+              <td align="left" colspan="1" rowspan="1">Register</td>
+              <td align="left" colspan="1" rowspan="1">Register sent as Probe of RP, the encapsulated IP data packet should not be forwarded</td>
+            </tr>
+            <tr>
+              <td align="left" colspan="1" rowspan="1">RPT</td>
+              <td align="left" colspan="1" rowspan="1">Route entry</td>
+              <td align="left" colspan="1" rowspan="1">Entry represents state on the RP-tree</td>
+            </tr>
+            <tr>
+              <td align="left" colspan="1" rowspan="1">RPT</td>
+              <td align="left" colspan="1" rowspan="1">Join/Prune</td>
