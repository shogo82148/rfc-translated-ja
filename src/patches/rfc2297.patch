+              <dt pn="section-3.2-6.4.1.11">21:</dt>
+              <dd pn="section-3.2-6.4.1.12">One or more of the specified output VCIs is invalid.</dd>
+              <dt pn="section-3.2-6.4.1.13">22:</dt>
+              <dd pn="section-3.2-6.4.1.14">
+                <t indent="0" pn="section-3.2-6.4.1.14.1">Invalid Class of Service field in a Connection Management
+message.</t>
+                <t indent="0" pn="section-3.2-6.4.1.14.2">The value of the Class of Service field is invalid.</t>
+              </dd>
+              <dt pn="section-3.2-6.4.1.15">23:</dt>
+              <dd pn="section-3.2-6.4.1.16">
+                <t indent="0" pn="section-3.2-6.4.1.16.1">Insufficient resources for QoS Profile.</t>
