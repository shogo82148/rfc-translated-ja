  <front>
    <title>Update to the Telephony Routing over IP (TRIP) IANA Registry Rules regarding Postal Addresses</title>
    <seriesInfo name="RFC" value="8602" stream="IETF"/>
    <date year="2019" month="July"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This memo updates the IANA registry rules for the Telephony Routing
over IP (TRIP) protocol, by no longer requiring that postal addresses
be included in contact information.</t>
      <t indent="0" pn="section-abstract-2">This memo updates RFC 3219.</t>
    </abstract>
