  <front>
    <title>The Null Packet</title>
    <seriesInfo name="RFC" value="6592" stream="independent"/>
    <author fullname="C. Pignataro" initials="C." surname="Pignataro">
      <organization showOnFrontPage="true">Cisco</organization>
      <address/>
    </author>
    <date year="2012" month="April" day="1"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">The ever-elusive Null Packet received numerous mentions in documents
in the RFC series, but it has never been explicitly defined.  This
memo corrects that omission.</t>
    </abstract>
