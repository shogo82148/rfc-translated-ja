-    <title>ASCII text file of hostnames</title>
+    <title>ASCII TEXT FILE OF HOSTNAMES</title>
     <seriesInfo name="RFC" value="627" stream="IETF"/>
-    <date year="1974" month="March"/>
+    <author fullname="Mike Kudlick" initials="M." surname="Kudlick">
+      <organization showOnFrontPage="true">SRI-ARC</organization>
+      <address/>
