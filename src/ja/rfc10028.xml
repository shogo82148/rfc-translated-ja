        <reference anchor="RFC2908" target="https://www.rfc-editor.org/info/rfc2908" quoteTitle="true" derivedAnchor="RFC2908">
          <front>
            <title>The Internet Multicast Address Allocation Architecture</title>
            <author fullname="D. Thaler" initials="D." surname="Thaler"/>
            <author fullname="M. Handley" initials="M." surname="Handley"/>
            <author fullname="D. Estrin" initials="D." surname="Estrin"/>
            <date month="September" year="2000"/>
            <abstract>
              <t indent="0">This document proposes a multicast address allocation architecture (MALLOC) for the Internet. This memo provides information for the Internet community.</t>
            </abstract>
          </front>
          <seriesInfo name="RFC" value="2908"/>
