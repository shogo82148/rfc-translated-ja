  <front>
    <title>IPv6のための動的ホスト構成プロトコル（DHCPv6）Relay Agent Subscriber-IDオプション</title>
    <seriesInfo name="RFC" value="4580" stream="IETF"/>
    <author fullname="Bernard Volz" initials="B." surname="Volz">
      <organization showOnFrontPage="true">Cisco Systems, Inc.</organization>
      <address>
        <postal>
