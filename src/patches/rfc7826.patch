-        <t indent="0" pn="section-18.1-6"><artwork name="" type="" align="left" alt=""><![CDATA[
+        <artwork name="" type="" align="left" alt="" pn="section-18.1-6"><![CDATA[
   Accept: application/example ;q=0.7, application/sdp
 ]]></artwork>
-</t>
