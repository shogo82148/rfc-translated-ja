  <front>
    <title>IMP-IMP and HOST-HOST Control Links</title>
    <seriesInfo name="RFC" value="18" stream="IETF"/>
    <author fullname="Vint Cerf" initials="V." surname="Cerf">
      <organization showOnFrontPage="true">University of California Los Angeles</organization>
      <address/>
    </author>
    <date year="1969" month="September"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">It is suggested that link 1 be used for the HOST-HOST control link
and link 0 be used for IMP-IMP control.</t>
      <t indent="0" pn="section-abstract-2">This will facilitate communication between Hosts and reduce delays
due to interference with IMP-IMP communications.</t>
      <t indent="0" pn="section-abstract-3">[This RFC has been restored to on-line status by Elmar K. Bins]</t>
    </abstract>
