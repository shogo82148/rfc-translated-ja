  <front>
    <title>STUN（Session Traversal Utilities for NAT）の用途のためのALPN（Application-Layer Protocol Negotiation）ラベル</title>
    <seriesInfo name="RFC" value="7443" stream="IETF"/>
    <author fullname="P. Patil" initials="P." surname="Patil">
      <organization showOnFrontPage="true">Cisco</organization>
      <address/>
