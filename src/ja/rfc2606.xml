  <front>
    <title>予約済みのトップレベルDNS名</title>
    <seriesInfo name="RFC" value="2606" stream="IETF"/>
    <seriesInfo name="BCP" value="32"/>
    <author fullname="D. Eastlake" initials="D." surname="Eastlake">
      <organization showOnFrontPage="true"/>
      <address/>
    </author>
    <author fullname="A. Panitz" initials="A." surname="Panitz">
      <organization showOnFrontPage="true"/>
      <address/>
    </author>
    <date year="1999" month="June"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">衝突と混乱の可能性を減らすために、いくつかのトップレベルドメイン名を、プライベートなテストや文書中の例などで使用するために予約します。さらに、例として使用するために予約されているいくつかのセカンドレベルドメイン名についても記載します。</t>
    </abstract>
