<?xml version='1.0' encoding='utf-8'?>
<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" indexInclude="true" number="18" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
<link href="https://dx.doi.org/10.17487/rfc18" rel="alternate"/>
  <front>
    <title>IMP-IMP および HOST-HOST 制御リンク</title>
    <seriesInfo name="RFC" value="18" stream="IETF"/>
    <author fullname="Vint Cerf">
      <organization>University of California Los Angeles</organization>
    </author>
    <date year="1969" month="September"/>
  </front>
  <middle>
    <t indent="0" pn="section-1">HOST-HOST 制御リンクにはリンク1を、IMP-IMP 制御にはリンク0を使うことを提案します。</t>
    <t indent="0" pn="section-2">これにより、ホスト間の通信が円滑になり、IMP-IMP 通信との干渉による遅延が減ります。</t>
    <t indent="0" pn="section-3">[この RFC は Elmar K. Bins によってオンライン状態に復元されました]</t>
  </middle>
</rfc>
