  <front>
    <title abbrev="Responsibility Change for the RFC Series">RFCシリーズの責任の変更</title>
    <seriesInfo name="RFC" value="9282" stream="IETF"/>
    <seriesInfo name="BCP" value="9" stream="IETF"/>
    <author initials="B." surname="Rosen" fullname="Brian Rosen">
