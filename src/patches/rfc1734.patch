-      <t indent="0" pn="section-3-13">CRLF            ::= CR LF</t>
-      <t indent="0" pn="section-3-14">CTL             ::= &lt;any ASCII control character and DEL,
-                     0x00 - 0x1f, 0x7f&gt;</t>
-      <t indent="0" pn="section-3-15">LF              ::= &lt;ASCII LF, line feed, 0x0A&gt;</t>
