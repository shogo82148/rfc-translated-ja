  <front>
    <title>A New Cryptographic Signature Method for DomainKeys Identified Mail (DKIM)</title>
    <seriesInfo name="RFC" value="8463" stream="IETF"/>
    <date year="2018" month="September"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document adds a new signing algorithm, Ed25519-SHA256, to
&quot;DomainKeys Identified Mail (DKIM) Signatures&quot; (RFC 6376).  DKIM
verifiers are required to implement this algorithm.</t>
    </abstract>
