+ <xs:simpleType name="duration.datatype">
+  <xs:restriction base="xs:string">
+   <xs:pattern value="(\+|\-)?([0-9]*\.)?[0-9]+(ms|s)"/>
+  </xs:restriction>
+ </xs:simpleType>
+</xs:schema>
+]]></artwork>
