  <middle>
    <section anchor="introduction" numbered="true" removeInRFC="false" toc="include" pn="section-1">
      <name slugifiedName="name-introduction">Introduction</name>
      <t indent="0" pn="section-1-1">This document contains the body parts defined in RFC 1495 for
carrying image formats that were originally defined in MIME through
an X.400 system.</t>
      <t indent="0" pn="section-1-2">It also documents the OIDs assigned to these data formats as FTAM
body parts, which allow the MIME types to be converted to FTAM body
parts; this will probably be more useful than the new body parts
defined here.</t>
    </section>
    <section anchor="newly-defined-x.400-body-parts" numbered="true" removeInRFC="false" toc="include" pn="section-2">
      <name slugifiedName="name-newly-defined-x.400-body-parts">Newly defined X.400 body parts</name>
      <section anchor="the-jpeg-body-part" numbered="true" removeInRFC="false" toc="include" pn="section-2.1">
        <name slugifiedName="name-the-jpeg-body-part">The JPEG body part</name>
        <t indent="0" pn="section-2.1-1">The following Extended Body Part is defined for JPEG data streams.
It has no parameters.</t>
        <sourcecode type="asn.1" markers="false" pn="section-2.1-2"><![CDATA[
jpeg-body-part EXTENDED-BODY-PART-TYPE
  DATA            OCTET STRING
  ::= mime-jpeg-body
]]></sourcecode>
        <sourcecode type="asn.1" markers="false" pn="section-2.1-3"><![CDATA[
mime-jpeg-body OBJECT IDENTIFIER ::=
        { mixer-bp-data 3 }
]]></sourcecode>
        <t indent="0" pn="section-2.1-4">The content is as defined in <xref target="MIME" format="default" sectionFormat="of" derivedContent="MIME"/>.</t>
      </section>
      <section anchor="the-gif-body-part" numbered="true" removeInRFC="false" toc="include" pn="section-2.2">
        <name slugifiedName="name-the-gif-body-part">The GIF body part</name>
        <t indent="0" pn="section-2.2-1">The following Extended Body Part is defined for GIF data streams.  It
has no parameters.</t>
        <sourcecode type="asn.1" markers="false" pn="section-2.2-2"><![CDATA[
gif-body-part EXTENDED-BODY-PART-TYPE
  DATA            OCTET STRING
  ::= mime-gif-body
]]></sourcecode>
        <sourcecode type="asn.1" markers="false" pn="section-2.2-3"><![CDATA[
mime-gif-body OBJECT IDENTIFIER ::=
        { mixer-bp-data 4 }
]]></sourcecode>
        <t indent="0" pn="section-2.2-4">The content is as defined in <xref target="MIME" format="default" sectionFormat="of" derivedContent="MIME"/>.</t>
      </section>
    </section>
    <section anchor="defined-equivalences-with-mime-types" numbered="true" removeInRFC="false" toc="include" pn="section-3">
      <name slugifiedName="name-defined-equivalences-with-mime-types">Defined equivalences with MIME types</name>
      <section anchor="image/jpeg---jpeg-body-part" numbered="true" removeInRFC="false" toc="include" pn="section-3.1">
        <name slugifiedName="name-image/jpeg---jpeg-body-part">image/jpeg - jpeg-body-part</name>
        <dl newline="false" spacing="normal" indent="3" pn="section-3.1-1">
          <dt pn="section-3.1-1.1">X.400 Body Part:</dt>
          <dd pn="section-3.1-1.2">Extended Body Part, OID jpeg-body-part</dd>
          <dt pn="section-3.1-1.3">MIME Content-Type:</dt>
          <dd pn="section-3.1-1.4">image/jpeg</dd>
          <dt pn="section-3.1-1.5">Conversion:</dt>
          <dd pn="section-3.1-1.6">None</dd>
        </dl>
      </section>
      <section anchor="image/jpeg---ftam-ema-jpeg" numbered="true" removeInRFC="false" toc="include" pn="section-3.2">
        <name slugifiedName="name-image/jpeg---ftam-ema-jpeg">image/jpeg - FTAM EMA JPEG</name>
        <dl newline="false" spacing="normal" indent="3" pn="section-3.2-1">
          <dt pn="section-3.2-1.1">X.400 Body Part:</dt>
          <dd pn="section-3.2-1.2">FTAM EMA JPEG</dd>
          <dt pn="section-3.2-1.3">MIME Content-Type:</dt>
          <dd pn="section-3.2-1.4">image/jpeg</dd>
          <dt pn="section-3.2-1.5">Conversion:</dt>
          <dd pn="section-3.2-1.6">None</dd>
        </dl>
        <t indent="0" pn="section-3.2-2">The OID assigned to JPEG by EMA in <xref target="MAWG" format="default" sectionFormat="of" derivedContent="MAWG"/> is</t>
        <artwork name="" type="" align="left" alt="" pn="section-3.2-3"><![CDATA[
{ ema objects(2) messaging (2) attachments(1) jpeg-image(6) }
]]></artwork>
        <t indent="0" pn="section-3.2-4">while EMA's OID is</t>
        <artwork name="" type="" align="left" alt="" pn="section-3.2-5"><![CDATA[
{ joint-iso-ccitt(2) country(16) us(840) organization(1)
ema(113694) }
]]></artwork>
        <t indent="0" pn="section-3.2-6">making the total OID, numeric only</t>
        <artwork name="" type="" align="left" alt="" pn="section-3.2-7"><![CDATA[
{ 2 16 840 1 113694 2 2 1 6 }
]]></artwork>
      </section>
      <section anchor="image/gif---gif-body-part" numbered="true" removeInRFC="false" toc="include" pn="section-3.3">
        <name slugifiedName="name-image/gif---gif-body-part">image/gif - gif-body-part</name>
        <dl newline="false" spacing="normal" indent="3" pn="section-3.3-1">
          <dt pn="section-3.3-1.1">X.400 Body Part:</dt>
          <dd pn="section-3.3-1.2">Extended Body Part, OID gif-body-part</dd>
          <dt pn="section-3.3-1.3">MIME Content-Type:</dt>
          <dd pn="section-3.3-1.4">image/gif</dd>
          <dt pn="section-3.3-1.5">Conversion:</dt>
          <dd pn="section-3.3-1.6">None</dd>
        </dl>
      </section>
      <section anchor="image/gif---ftam-ema-gif" numbered="true" removeInRFC="false" toc="include" pn="section-3.4">
        <name slugifiedName="name-image/gif---ftam-ema-gif">image/gif - FTAM EMA GIF</name>
        <dl newline="false" spacing="normal" indent="3" pn="section-3.4-1">
          <dt pn="section-3.4-1.1">X.400 Body Part:</dt>
          <dd pn="section-3.4-1.2">FTAM EMA GIF</dd>
          <dt pn="section-3.4-1.3">MIME Content-Type:</dt>
          <dd pn="section-3.4-1.4">image/jpeg</dd>
          <dt pn="section-3.4-1.5">Conversion:</dt>
          <dd pn="section-3.4-1.6">None</dd>
        </dl>
        <t indent="0" pn="section-3.4-2">The OID assigned to JPEG by EMA in <xref target="MAWG" format="default" sectionFormat="of" derivedContent="MAWG"/> is</t>
        <artwork name="" type="" align="left" alt="" pn="section-3.4-3"><![CDATA[
{ ema objects(2) messaging (2) attachments(1) gif-image(4) }
]]></artwork>
      </section>
    </section>
