+                chime = 0;
+                for (i = 0; i < n; i++) {
+                        chime -= s.m[i].type;
+                        if (chime >= n - found) {
+                                low = s.m[i].edge;
+                                break;
+                        }
+                        if (s.m[i].type == 0)
