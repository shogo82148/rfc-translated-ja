+    <section anchor="authors-information" numbered="true" removeInRFC="false" toc="include" pn="section-9.0">
+      <name slugifiedName="name-authors-information">Author's Information</name>
+      <author fullname="Rob Coltun" initials="R." surname="Coltun">
+        <organization showOnFrontPage="true">FORE Systems</organization>
