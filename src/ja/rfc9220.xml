    <title>HTTP/3によるWebSocketのブートストラップ</title>
    <seriesInfo name="RFC" value="9220" stream="IETF"/>
    <author initials="R." surname="Hamilton" fullname="Ryan Hamilton">
      <organization showOnFrontPage="true">Google</organization>
