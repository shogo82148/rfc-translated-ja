+
+dtmf-term-timeout     =    "DTMF-Term-Timeout" ":" 1*19DIGIT
+                        CRLF
+
+dtmf-term-char        =    "DTMF-Term-Char" ":" VCHAR CRLF
+
+save-waveform         =    "Save-Waveform" ":" BOOLEAN CRLF
+
+new-audio-channel     =    "New-Audio-Channel" ":"
+                        BOOLEAN CRLF
+
+recognition-mode      =    "Recognition-Mode" ":"
