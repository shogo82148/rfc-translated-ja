           <section anchor="authority-information-access" numbered="true" removeInRFC="false" toc="include" pn="section-4.2.2.1">
             <name slugifiedName="name-authority-information-access">Authority Information Access</name>
-            <t indent="0" pn="section-4.2.2.1-1">The authority information access extension indicates how to access CA
