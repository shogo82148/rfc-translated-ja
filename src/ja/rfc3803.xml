<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" docName="draft-ietf-vpim-vpimv2r2-dur-03" indexInclude="true" number="3803" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
