    <title abbrev="Use of VAPID in JMAP Web Push">JSON Meta Application Protocol（JMAP）のWeb PushにおけるVoluntary Application Server Identification（VAPID）の使用</title>
    <seriesInfo name="RFC" value="9749" stream="IETF"/>
    <author initials="D." surname="Gultsch" fullname="Daniel Gultsch">
      <address>
        <email>daniel@gultsch.de</email>
      </address>
