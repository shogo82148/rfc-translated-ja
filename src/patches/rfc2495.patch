+             OBJECT dsx1SignalMode
+                 SYNTAX INTEGER {
+                     messageOriented(4)
+                 }
+                 MIN-ACCESS read-only
+                 DESCRIPTION
+                     "Signaling on E1 ISDN Primary Rate interfaces
+                      is always message oriented."
