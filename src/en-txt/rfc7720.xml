  <front>
    <title>DNS Root Name Service Protocol and Deployment Requirements</title>
    <seriesInfo name="RFC" value="7720" stream="IETF"/>
    <author fullname="M. Blanchet" initials="M." surname="Blanchet">
      <organization showOnFrontPage="true">Viagenie</organization>
      <address/>
    </author>
    <author fullname="L-J. Liman" initials="L-J." surname="Liman">
      <organization showOnFrontPage="true">Netnod</organization>
      <address/>
    </author>
    <date year="2015" month="December"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">The DNS root name service is a critical part of the Internet
architecture.  The protocol and deployment requirements for the DNS
root name service are defined in this document.  Operational
requirements are out of scope.</t>
    </abstract>
