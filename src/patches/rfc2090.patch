     <title>TFTP Multicast Option</title>
     <seriesInfo name="RFC" value="2090" stream="IETF"/>
+    <author fullname="A. Emberson" initials="A." surname="Emberson">
+      <organization showOnFrontPage="true">Lanworks Technologies Inc.</organization>
