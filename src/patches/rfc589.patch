+              <tr>
+                <td align="left" colspan="1" rowspan="1">6</td>
+                <td align="left" colspan="1" rowspan="1">In compressed text, duplicate character string extends line longer than 255 bytes.</td>
+              </tr>
+              <tr>
+                <td align="left" colspan="1" rowspan="1">7</td>
