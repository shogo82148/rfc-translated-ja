+      <t indent="0" pn="section-10-1">IANA has assigned a new URI from the &quot;IETF XML Registry&quot; <xref target="RFC3688" format="default" sectionFormat="of" derivedContent="RFC3688"/>.</t>
+      <artwork name="" type="" align="left" alt="" pn="section-10-2"><![CDATA[
+URI: urn:ietf:params:xml:ns:yang:ietf-l2vpn-svc
+Registrant Contact: The IESG
+XML: N/A; the requested URI is an XML namespace
+]]></artwork>
+      <t indent="0" pn="section-10-3">IANA has assigned a new YANG module name in the &quot;YANG Module Names&quot;
+registry <xref target="RFC6020" format="default" sectionFormat="of" derivedContent="RFC6020"/>.</t>
+      <artwork name="" type="" align="left" alt="" pn="section-10-4"><![CDATA[
+name: ietf-l2vpn-svc
+namespace: urn:ietf:params:xml:ns:yang:ietf-l2vpn-svc
+prefix: l2vpn-svc
+reference: RFC 8466
+]]></artwork>
