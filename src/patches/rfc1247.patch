+<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="std" docName="draft-ietf-ospf-ospf2-01" obsoletes="1131" indexInclude="true" number="1247" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
   <link href="https://datatracker.ietf.org/doc/draft-ietf-ospf-ospf2-01" rel="prev"/>
