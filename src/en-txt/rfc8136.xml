  <front>
    <title>Additional Transition Functionality for IPv6</title>
    <seriesInfo name="RFC" value="8136" stream="independent"/>
    <date year="2017" month="April" day="1"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document proposes an additional mechanism intended to both
facilitate transition from IPv4 to IPv6 and improve the latter's
security and privacy.</t>
    </abstract>
