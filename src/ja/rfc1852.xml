  <front>
    <title>鍵付きSHAを用いたIP認証</title>
    <seriesInfo name="RFC" value="1852" stream="IETF"/>
    <author fullname="Perry Metzger" initials="P." surname="Metzger">
      <organization showOnFrontPage="true">Piermont</organization>
      <address/>
    </author>
    <author fullname="William Allen Simpson" initials="W. A." surname="Simpson">
      <organization showOnFrontPage="true">Daydreamer</organization>
      <address/>
    </author>
    <date year="1995" month="September"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">この文書は、IP認証ヘッダーでの鍵付きSHAの使い方を説明します。</t>
    </abstract>
