  <front>
    <title>IANA Registration for Enumservice 'iax'</title>
    <seriesInfo name="RFC" value="6315" stream="IETF"/>
    <date year="2011" month="July"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document registers an Enumservice for the Inter-Asterisk
eXchange (IAX) protocol according to the guidelines given in RFC
6117.</t>
    </abstract>
