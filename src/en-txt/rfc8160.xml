  <front>
    <title>IUTF8 Terminal Mode in Secure Shell (SSH)</title>
    <seriesInfo name="RFC" value="8160" stream="IETF"/>
    <author fullname="S. Tatham" initials="S." surname="Tatham">
      <organization showOnFrontPage="true">PuTTY</organization>
      <address/>
    </author>
    <author fullname="D. Tucker" initials="D." surname="Tucker">
      <organization showOnFrontPage="true">OpenSSH</organization>
      <address/>
    </author>
    <date year="2017" month="April"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document specifies a new opcode in the Secure Shell terminal
modes encoding.  The new opcode describes the widely used IUTF8
terminal mode bit, which indicates that terminal I/O uses UTF-8
character encoding.</t>
    </abstract>
