<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="std" docName="draft-malkin-tftpexts-options-00" indexInclude="true" number="2349" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
