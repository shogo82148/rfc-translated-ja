+      dsx0RobbedBitSignalling
+      dsx0IdleCode
+      dsx0SeizedCode
+      dsx0TransmitCodesEnable
+      dsx0BundleRowStatus
+      dsx0BondMode
+      dsx0BondRowStatus
+]]></artwork>
+      <t indent="0" pn="section-9-6">Setting the following objects is mischievous, but not harmful to traffic.</t>
+      <artwork name="" type="" align="left" alt="" pn="section-9-7"><![CDATA[
+      dsx0CircuitIdentifier
+      dsx0BundleNextIndex
+]]></artwork>
