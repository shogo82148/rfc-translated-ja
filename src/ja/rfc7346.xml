  <front>
    <title>IPv6マルチキャストアドレスのスコープ</title>
    <seriesInfo name="RFC" value="7346" stream="IETF"/>
    <author fullname="R. Droms" initials="R." surname="Droms">
      <organization showOnFrontPage="true">Cisco</organization>
      <address/>
    </author>
    <date year="2014" month="August"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">この文書は、IPv6マルチキャストスコープの定義を更新し、それによってRFC 4007とRFC 4291を更新します。</t>
    </abstract>
