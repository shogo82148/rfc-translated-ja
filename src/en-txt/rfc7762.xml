  <front>
    <title>Initial Assignment for the Content Security Policy Directives Registry</title>
    <seriesInfo name="RFC" value="7762" stream="IETF"/>
    <author fullname="M. West" initials="M." surname="West">
      <organization showOnFrontPage="true">Google, Inc</organization>
      <address/>
    </author>
    <date year="2016" month="January"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document establishes an Internet Assigned Number Authority
(IANA) registry for Content Security Policy directives and populates
that registry with the directives defined in the Content Security
Policy Level 2 specification.</t>
    </abstract>
