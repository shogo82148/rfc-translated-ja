+              <t indent="0" pn="section-6.2.1.3.1-33">ACE4_WRITE_OWNER</t>
+              <ul bare="false" empty="true" indent="3" spacing="normal" pn="section-6.2.1.3.1-34">
+                <li pn="section-6.2.1.3.1-34.1">
+                  <dl newline="true" spacing="normal" indent="3" pn="section-6.2.1.3.1-34.1.1">
+                    <dt pn="section-6.2.1.3.1-34.1.1.1">Operation(s) affected:</dt>
+                    <dd pn="section-6.2.1.3.1-34.1.1.2">SETATTR of owner and owner_group</dd>
