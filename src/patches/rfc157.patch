+    <title>Invitation to the Second Symposium on Problems in the Optimization of Data Communication Systems</title>
     <seriesInfo name="RFC" value="157" stream="IETF"/>
+    <author fullname="V. Cerf" initials="V." surname="Cerf">
+      <organization showOnFrontPage="true">UCLA</organization>
+      <address/>
