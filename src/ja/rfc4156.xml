<?xml version='1.0' encoding='utf-8'?>
<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="historic" docName="draft-hoffman-wais-uri-03" indexInclude="true" number="4156" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
