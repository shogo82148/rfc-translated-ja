+         -- DURATION_HOUR  = 60;
+         -- DURATION_DAY   = 1440;
+         -- DURATION_WEEK  = 10080;
+         -- DURATION_MONTH = 43200;// 30 days
+         -- DURATION_YEAR  = 525600;//365 days
