  <front>
    <title>ポイントツーポイントプロトコル（PPP）のIANAに関する考慮事項</title>
    <seriesInfo name="RFC" value="3818" stream="IETF"/>
    <author fullname="V. Schryver" initials="V." surname="Schryver">
      <organization showOnFrontPage="true">Rhyolite Software</organization>
      <address>
        <postal>
          <street>2482 Lee Hill Drive</street>
