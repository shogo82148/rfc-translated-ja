+       [ mdn-gateway-field CRLF ]
+       [ original-recipient-field CRLF ]
+       final-recipient-field CRLF
+       [ original-message-id-field CRLF ]
+       disposition-field CRLF
+       *( failure-field CRLF )
+       *( error-field CRLF )
+       *( warning-field CRLF )
+       *( extension-field CRLF )
+
+  address-type = atom
+
+  mta-name-type = atom
+
+  reporting-ua-field = "Reporting-UA" ":" ua-name
