  <front>
    <title>PKCS #5: Password-Based Key Derivation Function 2 (PBKDF2) Test Vectors</title>
    <seriesInfo name="RFC" value="6070" stream="IETF"/>
    <author fullname="S. Josefsson" initials="S." surname="Josefsson">
      <organization showOnFrontPage="true">SJD AB</organization>
      <address/>
    </author>
    <date year="2011" month="January"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document contains test vectors for the Public-Key Cryptography
Standards (PKCS) #5 Password-Based Key Derivation Function 2 (PBKDF2)
with the Hash-based Message Authentication Code (HMAC) Secure Hash
Algorithm (SHA-1) pseudorandom function.</t>
    </abstract>
