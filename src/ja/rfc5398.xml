<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" docName="draft-ietf-idr-as-documentation-reservation-00" indexInclude="true" number="5398" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
