<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="std" docName="draft-ietf-dhc-nsso-05" indexInclude="true" number="2937" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
