<?xml version='1.0' encoding='utf-8'?>
<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="info" docName="draft-eronen-enterprise-number-documentation-01" indexInclude="true" number="5612" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
