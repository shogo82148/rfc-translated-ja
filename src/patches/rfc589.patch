+          <table align="center" pn="table-1">
+            <thead>
+              <tr>
+                <th align="left" colspan="1" rowspan="1">CODE</th>
+                <th align="left" colspan="1" rowspan="1">ERROR</th>
+              </tr>
+            </thead>
+            <tbody>
+              <tr>
+                <td align="left" colspan="1" rowspan="1">1</td>
+                <td align="left" colspan="1" rowspan="1">Device id byte has high bit off.</td>
+              </tr>
+              <tr>
+                <td align="left" colspan="1" rowspan="1">2</td>
+                <td align="left" colspan="1" rowspan="1">End of transaction in the middle of a data line.</td>
+              </tr>
+              <tr>
+                <td align="left" colspan="1" rowspan="1">3</td>
+                <td align="left" colspan="1" rowspan="1">Truncated input line longer than 255 bytes.</td>
+              </tr>
+              <tr>
+                <td align="left" colspan="1" rowspan="1">4</td>
+                <td align="left" colspan="1" rowspan="1">In compressed text, string control byte has high bit off.</td>
