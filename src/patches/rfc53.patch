-    <title>Official protocol mechanism</title>
+    <title>An Official Protocol Mechanism</title>
     <seriesInfo name="RFC" value="53" stream="IETF"/>
-    <date year="1970" month="June"/>
+    <author fullname="S. Crocker" initials="S." surname="Crocker">
+      <organization showOnFrontPage="true">UCLA</organization>
+      <address/>
