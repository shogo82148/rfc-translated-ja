+        )
+{
+        struct p *p;            /* dummy peer structure pointer */
+
+        /*
+         * Search association table for matching source
+         * address, source port and mode.
+         */
+        while (/* all associations */ 0) {
+                if (r->srcaddr == p->srcaddr && r->mode == p->hmode)
+                        return(p);
+        }
+        return (NULL);
+}
