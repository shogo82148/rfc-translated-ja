-          <section anchor="idup_ev-major_status-codes" numbered="true" removeInRFC="false" toc="include" pn="section-2.3.3.3">
-            <name slugifiedName="name-idup_ev-major_status-codes">IDUP_EV major_status codes</name>
-            <t indent="0" pn="section-2.3.3.3-1">The following major_status return codes are defined for the &quot;EV&quot;
-calls in this section:</t>
-            <ul bare="false" empty="false" indent="3" spacing="normal" pn="section-2.3.3.3-2">
-              <li pn="section-2.3.3.3-2.1"> GSS_S_COMPLETE
