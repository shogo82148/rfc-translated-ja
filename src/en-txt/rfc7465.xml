  <front>
    <title>Prohibiting RC4 Cipher Suites</title>
    <seriesInfo name="RFC" value="7465" stream="IETF"/>
    <author fullname="A. Popov" initials="A." surname="Popov">
      <organization showOnFrontPage="true">Microsoft Corp.</organization>
      <address/>
    </author>
    <date year="2015" month="February"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document requires that Transport Layer Security (TLS) clients
and servers never negotiate the use of RC4 cipher suites when they
establish connections.  This applies to all TLS versions.  This
document updates RFCs 5246, 4346, and 2246.</t>
    </abstract>
