  <front>
    <title>Hebrew Character Encoding for Internet Messages</title>
    <seriesInfo name="RFC" value="1555" stream="IETF"/>
    <author fullname="H. Nussbacher" initials="H." surname="Nussbacher">
      <organization showOnFrontPage="true">Israeli Inter-University Computer Center</organization>
      <address/>
    </author>
    <author fullname="Y. Bourvine" initials="Y." surname="Bourvine">
      <organization showOnFrontPage="true">Hebrew University</organization>
      <address/>
    </author>
    <date year="1993" month="December"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document describes the encoding used in electronic mail <xref target="RFC822" format="default" sectionFormat="of" derivedContent="RFC822"/>
for transferring Hebrew.  The standard devised makes use of MIME
<xref target="RFC1521" format="default" sectionFormat="of" derivedContent="RFC1521"/> and ISO-8859-8.</t>
    </abstract>
    <boilerplate>
      <section anchor="status-of-memo" numbered="false" removeInRFC="false" toc="exclude" pn="section-boilerplate.1">
        <name slugifiedName="name-status-of-this-memo">Status of This Memo</name>
        <t indent="0" pn="section-boilerplate.1.1">This memo provides information for the Internet community.  This memo
does not specify an Internet standard of any kind.  Distribution of
this memo is unlimited.</t>
      </section>
    </boilerplate>
  </front>
  <middle>
    <section anchor="description" numbered="false" removeInRFC="false" toc="include" pn="section-unnumbered-1">
      <name slugifiedName="name-description">Description</name>
      <t indent="0" pn="section-unnumbered-1-1">All Hebrew text when transferred via e-mail must first be translated
into ISO-8859-8, and then encoded using either Quoted-Printable
(preferable) or Base64, as defined in MIME.</t>
