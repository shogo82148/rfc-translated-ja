<?xml version='1.0' encoding='utf-8'?>
<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="info" docName="draft-eggert-tcpm-historicize-02" indexInclude="true" number="6247" obsoletes="1072, 1106, 1110, 1145, 1146, 1379, 1644, 1693" updates="4614" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
