+              <td align="left" colspan="1" rowspan="1"><xref target="section-18.14" format="default" sectionFormat="of" derivedContent="Section 18.14"/></td>
+            </tr>
+            <tr>
+              <td align="left" colspan="1" rowspan="1">Content-Encoding</td>
+              <td align="left" colspan="1" rowspan="1"><xref target="section-18.15" format="default" sectionFormat="of" derivedContent="Section 18.15"/></td>
+            </tr>
+            <tr>
