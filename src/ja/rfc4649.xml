  <front>
    <title>IPv6のための動的ホスト構成プロトコル（DHCPv6）Relay Agent Remote-IDオプション</title>
    <seriesInfo name="RFC" value="4649" stream="IETF"/>
    <author fullname="Bernard Volz" initials="B." surname="Volz">
      <organization showOnFrontPage="true">Cisco Systems, Inc.</organization>
      <address>
        <postal>
          <street>1414 Massachusetts Ave.</street>
          <city>Boxborough</city>
