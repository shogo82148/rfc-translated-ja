+      <t indent="0" pn="section-abstract-1">Workshop Announcement</t>
+      <dl newline="false" spacing="compact" indent="7" pn="section-abstract-2">
+        <dt pn="section-abstract-2.1">Title:</dt>
+        <dd pn="section-abstract-2.2">Automated Resource Sharing on the ARPANET</dd>
+        <dt pn="section-abstract-2.3">Date:</dt>
+        <dd pn="section-abstract-2.4">Monday May 21, 1973</dd>
+        <dt pn="section-abstract-2.5">Time:</dt>
+        <dd pn="section-abstract-2.6">9:00 AM to 5:00 PM</dd>
+        <dt pn="section-abstract-2.7">Place:</dt>
+        <dd pn="section-abstract-2.8">Bolt Beranek and Newman Inc., Cambridge, Mass.</dd>
+        <dt pn="section-abstract-2.9">Hosts:</dt>
+        <dd pn="section-abstract-2.10">TENEX and TIP Groups at BBN</dd>
+      </dl>
     </abstract>
