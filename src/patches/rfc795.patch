+            <th align="center" colspan="1" rowspan="1">DELAY</th>
+            <th align="center" colspan="1" rowspan="1">THROUGHPUT</th>
+            <th align="center" colspan="1" rowspan="1">RELIABILITY</th>
+          </tr>
+        </thead>
