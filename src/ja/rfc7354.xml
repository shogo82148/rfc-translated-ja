  <front>
    <title>Digital Video Broadcasting Project（DVB）のUniform Resource Name（URN）名前空間の登録者情報の更新</title>
    <seriesInfo name="RFC" value="7354" stream="IETF"/>
    <date year="2014" month="September"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">RFC 5328は、Digital Video Broadcasting Projectのために、Uniform Resource Name（URN）名前空間「dvb」を登録しました。この文書は、新しい登録者情報でRFC 5328を更新します。</t>
    </abstract>
