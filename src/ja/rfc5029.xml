    <title>IS-ISのリンク属性サブTLVの定義</title>
    <seriesInfo name="RFC" value="5029" stream="IETF"/>
    <author fullname="JP. Vasseur" initials="JP." surname="Vasseur">
      <organization showOnFrontPage="true">Cisco Systems, Inc</organization>
