  <front>
    <title>インターネットメッセージのための韓国語文字エンコーディング</title>
    <seriesInfo name="RFC" value="1557" stream="IETF"/>
    <author fullname="Uhhyung Choi" initials="U." surname="Choi">
      <organization showOnFrontPage="true">KAIST</organization>
      <address/>
    </author>
