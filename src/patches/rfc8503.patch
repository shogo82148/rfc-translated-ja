-          mplsL3VpnVrfName
-        }
-  ::= { mvpnBgpTable 1 }
-]]></artwork>
-</t>
-        <t indent="0" pn="section-3.2-61"><artwork name="" type="" align="left" alt=""><![CDATA[
-  MvpnBgpEntry ::= SEQUENCE {
-  mvpnBgpMode                            INTEGER,
-  mvpnBgpVrfRouteImportExtendedCommunity MplsL3VpnRouteDistinguisher,
-  mvpnBgpSrcASExtendedCommunity          Unsigned32,
