  <front>
    <title>Mobile IPv6のベンダー固有オプション</title>
    <seriesInfo name="RFC" value="5094" stream="IETF"/>
    <author fullname="V. Devarapalli" initials="V." surname="Devarapalli">
      <organization showOnFrontPage="true">Azaire Networks</organization>
      <address/>
    </author>
    <author fullname="A. Patel" initials="A." surname="Patel">
      <organization showOnFrontPage="true">Cisco</organization>
