  <front>
    <title>Content-MD5ヘッダーフィールド</title>
    <seriesInfo name="RFC" value="1544" stream="IETF"/>
    <author fullname="M. Rose" initials="M." surname="Rose">
      <organization showOnFrontPage="true">Dover Beach Consulting, Inc.</organization>
      <address/>
    </author>
    <date year="1993" month="November"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">このメモは、MIMEに準拠したメッセージで使用する、省略可能なヘッダーフィールドContent-MD5を規定します。</t>
    </abstract>
