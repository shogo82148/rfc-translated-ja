  <front>
    <title>Using the Generic Associated Channel Label for Pseudowire in the MPLS Transport Profile (MPLS-TP)</title>
    <seriesInfo name="RFC" value="6423" stream="IETF"/>
    <author fullname="H. Li" initials="H." surname="Li">
      <organization showOnFrontPage="true">China Mobile</organization>
      <address/>
    </author>
    <author fullname="L. Martini" initials="L." surname="Martini">
