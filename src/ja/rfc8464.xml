    <section anchor="namespace-registration-template" numbered="true" removeInRFC="false" toc="include" pn="section-3">
      <name slugifiedName="name-namespace-registration-template">名前空間登録テンプレート</name>
      <t indent="0" pn="section-3-1">記入済みの名前空間登録を次に示します。</t>
      <dl newline="false" spacing="normal" indent="3" pn="section-3-2">
        <dt pn="section-3-2.1">名前空間識別子（Namespace Identifier）：</dt>
        <dd pn="section-3-2.2">
          <t indent="0" pn="section-3-2.2.1">'3gpp2'</t>
        </dd>
