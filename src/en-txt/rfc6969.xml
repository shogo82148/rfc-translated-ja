            <td align="left" colspan="1" rowspan="1">Base IPv6 Unicast AF dependent on local policy</td>
            <td align="left" colspan="1" rowspan="1"><xref target="RFC5838" format="default" sectionFormat="of" derivedContent="RFC5838"/></td>
