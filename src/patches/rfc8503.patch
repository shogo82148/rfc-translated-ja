-        <t indent="0" pn="section-3.2-236"><artwork name="" type="" align="left" alt=""><![CDATA[
-   mvpnScalarGroup    OBJECT-GROUP
-       OBJECTS {
-                 mvpnMvrfs,
-                 mvpnV4Mvrfs,
-                 mvpnV6Mvrfs,
-                 mvpnPimV4Mvrfs,
-                 mvpnPimV6Mvrfs,
