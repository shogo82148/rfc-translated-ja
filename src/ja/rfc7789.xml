  <front>
    <title abbrev="Impact of BGP Filtering">BGPフィルタリングがドメイン間ルーティングポリシーに与える影響</title>
    <seriesInfo name="RFC" value="7789" stream="IETF"/>
    <author fullname="C. Cardona" initials="C." surname="Cardona">
      <organization showOnFrontPage="true">IMDEA Networks/UC3M</organization>
      <address/>
