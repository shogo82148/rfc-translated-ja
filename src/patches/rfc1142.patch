+                <td align="left" colspan="1" rowspan="1">delay  metric</td>
+                <td align="left" colspan="1" rowspan="1">1</td>
+                <td align="left" colspan="1" rowspan="1">0</td>
+                <td align="left" colspan="1" rowspan="1">0</td>
+              </tr>
+              <tr>
+                <td align="left" colspan="1" rowspan="1">error metric</td>
+                <td align="left" colspan="1" rowspan="1">0</td>
+                <td align="left" colspan="1" rowspan="1">1</td>
