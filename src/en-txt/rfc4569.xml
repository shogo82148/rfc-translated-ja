  <front>
    <title>Internet Assigned Numbers Authority (IANA) Registration of the Message Media Feature Tag</title>
    <seriesInfo name="RFC" value="4569" stream="IETF"/>
    <author fullname="G. Camarillo" initials="G." surname="Camarillo">
      <organization showOnFrontPage="true">Ericsson</organization>
      <address/>
    </author>
    <date year="2006" month="July"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document registers with the IANA a new media feature tag
associated with the 'message' media type.  This media feature tag
indicates that a particular device supports 'message' as a streaming
media type.  Media feature tags can be used to route calls to devices
that support certain features.</t>
    </abstract>
