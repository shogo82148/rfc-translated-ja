-    <title>Second Network Graphics meeting details</title>
+    <title>Second Network Graphics Meeting Details</title>
     <seriesInfo name="RFC" value="253" stream="IETF"/>
-    <date year="1971" month="October"/>
+    <author fullname="James A. Moorer" initials="J.A." surname="Moorer">
+      <organization showOnFrontPage="true">Stanford Al Laboratory</organization>
