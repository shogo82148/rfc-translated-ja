    <title>A Uniform Resource Name (URN) Namespace for Examples</title>
    <seriesInfo name="RFC" value="6963" stream="IETF"/>
    <seriesInfo name="BCP" value="183"/>
    <author fullname="P. Saint-Andre" initials="P." surname="Saint-Andre">
