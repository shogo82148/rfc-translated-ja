-</t>
-        <t indent="0" pn="section-3.2-75"><artwork name="" type="" align="left" alt=""><![CDATA[
-  MvpnPmsiEntry ::= SEQUENCE {
-  mvpnPmsiTunnelIfIndex          InterfaceIndex,
