            <td align="left" colspan="1" rowspan="1"><xref target="RFC1035" format="default" sectionFormat="of" derivedContent="RFC1035"/><xref target="RFC6895" format="default" sectionFormat="of" derivedContent="RFC6895"/> [RFC8482]</td>
