-]]></artwork>
-</t>
-        <t indent="0" pn="section-3.2-60"><artwork name="" type="" align="left" alt=""><![CDATA[
-  mvpnBgpEntry OBJECT-TYPE
-  SYNTAX           MvpnBgpEntry
