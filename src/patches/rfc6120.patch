+      </dl>
+      <dl newline="false" spacing="normal" indent="3" pn="section-15-54">
+      <dt pn="section-15-54.1">Feature:</dt>
+      <dd pn="section-15-54.2">tls-restart</dd>
+      <dt pn="section-15-54.3">Description:</dt>
+      <dd pn="section-15-54.4">Initiate or handle a stream restart after TLS negotiation.</dd>
