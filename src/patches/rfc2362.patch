+            </tr>
+            <tr>
+              <td align="left" colspan="1" rowspan="1">RPT</td>
+              <td align="left" colspan="1" rowspan="1">Assert</td>
+              <td align="left" colspan="1" rowspan="1">The data packet was routed down the shared tree; thus, the path indicated corresponds to the RP tree</td>
+            </tr>
+            <tr>
+              <td align="left" colspan="1" rowspan="1">SPT</td>
+              <td align="left" colspan="1" rowspan="1">(S,G) entry</td>
+              <td align="left" colspan="1" rowspan="1">Packets have arrived on the iif towards S, and the iif is different from the (*,G) iif</td>
+            </tr>
+            <tr>
+              <td align="left" colspan="1" rowspan="1">WC</td>
+              <td align="left" colspan="1" rowspan="1">Join</td>
+              <td align="left" colspan="1" rowspan="1">The receiver expects to receive packets from all sources via this (shared tree) path. Thus, the Join/Prune applies to a (*,G) entry</td>
+            </tr>
+            <tr>
+              <td align="left" colspan="1" rowspan="1">WC</td>
+              <td align="left" colspan="1" rowspan="1">Route entry</td>
+              <td align="left" colspan="1" rowspan="1">Wildcard entry; if there is no more specific match for a particular source, packets will be forwarded according to this entry</td>
+            </tr>
+          </tbody>
+        </table>
