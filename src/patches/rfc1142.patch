+        <ul spacing="normal" bare="false" empty="false" indent="3" pn="section-9.9-15">
+          <li pn="section-9.9-15.1">Address Length  Length of area address in octets.</li>
+          <li pn="section-9.9-15.2">Area Address  Area address.</li>
