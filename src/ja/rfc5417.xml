  <front>
    <title>CAPWAP（Control And Provisioning of Wireless Access Points）アクセスコントローラーDHCPオプション</title>
    <seriesInfo name="RFC" value="5417" stream="IETF"/>
    <author fullname="Pat R. Calhoun" initials="P." surname="Calhoun">
      <organization showOnFrontPage="true">Cisco Systems, Inc.</organization>
      <address>
        <postal>
          <street>170 West Tasman Drive</street>
