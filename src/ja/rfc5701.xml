<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" docName="draft-ietf-l3vpn-v6-ext-communities-02" indexInclude="true" number="5701" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
