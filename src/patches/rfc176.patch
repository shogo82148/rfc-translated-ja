-    <title>Comments on &quot;Byte size for connections&quot;</title>
+    <title>Comments on Byte Size for Connections</title>
     <seriesInfo name="RFC" value="176" stream="IETF"/>
+    <author fullname="A.K. Bhushan" initials="A.K." surname="Bhushan">
+      <organization showOnFrontPage="true">MIT</organization>
+      <address/>
+    </author>
+    <author fullname="R. Kanodia" initials="R." surname="Kanodia">
+      <organization showOnFrontPage="true">MIT</organization>
