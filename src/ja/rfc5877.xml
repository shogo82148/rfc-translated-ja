  <front>
    <title>属性証明書のためのapplication/pkix-attr-certメディアタイプ</title>
    <seriesInfo name="RFC" value="5877" stream="IETF"/>
    <author fullname="Russell Housley" initials="R." surname="Housley">
      <organization showOnFrontPage="true">Vigil Security, LLC</organization>
