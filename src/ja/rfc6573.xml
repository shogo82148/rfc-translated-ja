<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" docName="draft-amundsen-item-and-collection-link-relations-05" indexInclude="true" number="6573" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
  <link href="https://datatracker.ietf.org/doc/draft-amundsen-item-and-collection-link-relations-05" rel="prev"/>
<link href="https://dx.doi.org/10.17487/rfc6573" rel="alternate"/>
  <front>
    <title>itemとcollectionのリンク関係</title>
    <seriesInfo name="RFC" value="6573" stream="IETF"/>
    <date year="2012" month="April"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">RFC 5988は、Web上のリソース間の関係を示す手段を標準化しました。この仕様は、コレクションとそのメンバーの間の関係を表現するために使える、互いに対になる一組のリンク関係タイプを定義します。</t>
    </abstract>
