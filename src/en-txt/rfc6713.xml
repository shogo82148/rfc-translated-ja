  <front>
    <title>The 'application/zlib' and 'application/gzip' Media Types</title>
    <seriesInfo name="RFC" value="6713" stream="IETF"/>
    <date year="2012" month="August"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document defines the 'application/gzip' and 'application/zlib'
media types for compressed data using the gzip and zlib compression
formats.</t>
    </abstract>
