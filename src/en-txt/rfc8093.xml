  <front>
    <title>Deprecation of BGP Path Attribute Values 30, 31, 129, 241, 242, and 243</title>
    <seriesInfo name="RFC" value="8093" stream="IETF"/>
    <date year="2017" month="February"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document requests IANA to mark BGP path attribute values 30, 31,
129, 241, 242, and 243 as &quot;Deprecated&quot;.</t>
    </abstract>
