  <front>
    <title>インターネットメッセージのための日本語文字エンコーディング</title>
    <seriesInfo name="RFC" value="1468" stream="IETF"/>
    <author fullname="Jun Murai" initials="J." surname="Murai">
      <organization showOnFrontPage="true">Keio University</organization>
      <address/>
    </author>
    <author fullname="Mark Crispin" initials="M." surname="Crispin">
      <organization showOnFrontPage="true">Panda Programming</organization>
      <address/>
    </author>
