  <front>
    <title>第3世代パートナーシッププロジェクト（3GPP）のEvolved Packet System（EPS）のためのDiameterコマンドコードの登録</title>
    <seriesInfo name="RFC" value="5516" stream="IETF"/>
    <author fullname="M. Jones" initials="M." surname="Jones">
      <organization showOnFrontPage="true">Bridgewater Systems</organization>
