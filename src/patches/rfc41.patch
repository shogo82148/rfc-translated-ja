     <seriesInfo name="RFC" value="41" stream="IETF"/>
-    <date year="1970" month="March" day="30"/>
+    <author fullname="John Melvin" initials="J." surname="Melvin">
+      <organization showOnFrontPage="true">SRI/ARC</organization>
+      <address/>
