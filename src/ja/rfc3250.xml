  <front>
    <title>Tag Image File Format Fax eXtended（TIFF-FX） - image/tiff-fx MIMEサブタイプの登録</title>
    <seriesInfo name="RFC" value="3250" stream="IETF"/>
    <author fullname="L. McIntyre" initials="L." surname="McIntyre">
      <organization showOnFrontPage="true">Xerox Corporation</organization>
      <address/>
    </author>
    <author fullname="G. Parsons" initials="G." surname="Parsons">
