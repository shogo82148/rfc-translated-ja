<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" docName="draft-ietf-bgp-defaultroute-01" indexInclude="true" number="1397" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
