   <front>
     <title>Message Data Types</title>
     <seriesInfo name="RFC" value="42" stream="IETF"/>
+    <author fullname="E.I. Ancona" initials="E.I." surname="Ancona">
+      <organization showOnFrontPage="true">M.I.T. Lincoln Laboratory</organization>
+      <address/>
+    </author>
     <date year="1970" month="March" day="31"/>
     <abstract pn="section-abstract">
     </abstract>
-    <boilerplate>
