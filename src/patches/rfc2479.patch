-          <section anchor="idup_ev_singlebuffer_generate-call" numbered="true" removeInRFC="false" toc="include" pn="section-2.3.3.4">
-            <name slugifiedName="name-idup_ev_singlebuffer_generate-call">IDUP_EV_SingleBuffer_Generate call</name>
-            <t indent="0" pn="section-2.3.3.4-1">Inputs:
-o  env_handle                 ENVIRONMENT HANDLE,
-o  nr_operation               Nr_Operation,
-o  Nr_Options                 PARAMETER BUNDLE,
-o  idu_buffer                 OCTET STRING,
