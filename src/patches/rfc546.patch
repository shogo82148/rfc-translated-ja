-    <title>Tenex load averages for July 1973</title>
+    <title>TENEX Load Averages for July 1973</title>
     <seriesInfo name="RFC" value="546" stream="IETF"/>
+    <author fullname="B. Thomas" initials="B." surname="Thomas">
+      <organization showOnFrontPage="true">BBN-TENEX</organization>
