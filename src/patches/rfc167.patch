-    <title>Socket conventions reconsidered</title>
+    <title>Socket Conventions Reconsidered</title>
     <seriesInfo name="RFC" value="167" stream="IETF"/>
-    <date year="1971" month="May"/>
+    <author fullname="Athay Bhushan" initials="A." surname="Bhushan">
