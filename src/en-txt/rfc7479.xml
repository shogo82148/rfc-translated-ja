            <th align="center" colspan="1" rowspan="1">Value</th>
            <th align="center" colspan="1" rowspan="1">Description</th>
            <th align="center" colspan="1" rowspan="1">Reference</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td align="center" colspan="1" rowspan="1">4</td>
            <td align="center" colspan="1" rowspan="1">Ed25519</td>
            <td align="center" colspan="1" rowspan="1">[RFC7479]</td>
          </tr>
        </tbody>
      </table>
    </section>
