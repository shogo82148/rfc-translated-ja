  <front>
    <title>MPLSトランスポートプロファイル（MPLS-TP）の疑似回線における汎用関連チャネルラベルの使用</title>
    <seriesInfo name="RFC" value="6423" stream="IETF"/>
    <author fullname="H. Li" initials="H." surname="Li">
      <organization showOnFrontPage="true">China Mobile</organization>
      <address/>
