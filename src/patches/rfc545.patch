-    <title>Of what quality be the UCSB resources evaluators?</title>
+    <title>Of What Quality Be the UCSB Resource Evaluators?</title>
     <seriesInfo name="RFC" value="545" stream="IETF"/>
+    <author fullname="J. Pickens" initials="J." surname="Pickens">
+      <organization showOnFrontPage="true">UCSB Computer Systems Laboratory</organization>
