+      type ma-name-string;
+      description
+        "MA name string.";
+    }
+  }
+
+  grouping ma-name {
+    description
+      "MA name.";
+    leaf ma-name-format {
+      type identityref {
+        base name-format;
+
+      }
+      description
+        "MA name format.";
+    }
+    choice ma-name {
+      case ma-name-null {
+        leaf ma-name-null {
+          when "derived-from-or-self(../ma-name-format,"
