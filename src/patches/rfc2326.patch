     <section anchor="syntax" numbered="true" removeInRFC="false" toc="include" pn="section-15">
       <name slugifiedName="name-syntax">Syntax</name>
       <t indent="0" pn="section-15-1">The RTSP syntax is described in an augmented Backus-Naur form (BNF)
-as used in RFC 2068 [2].</t>
+as used in RFC 2068 <xref target="ref-2" format="default" sectionFormat="of" derivedContent="2"/>.</t>
