    <date year="2011" month="December"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document defines a value of &quot;application&quot; for the vCard KIND
property so that vCards can be used to represent software
applications.</t>
    </abstract>
