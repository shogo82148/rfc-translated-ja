  <front>
    <title>WebDAVの現在のプリンシパルの拡張</title>
    <seriesInfo name="RFC" value="5397" stream="IETF"/>
    <author fullname="W. Sanchez" initials="W." surname="Sanchez">
      <organization showOnFrontPage="true">Apple Inc.</organization>
      <address/>
