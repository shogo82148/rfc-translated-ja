<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" docName="draft-ietf-sidr-rpki-algs-05" indexInclude="true" number="6485" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
