<?xml version='1.0' encoding='utf-8'?>
<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="exp" docName="draft-ietf-ipngwg-test-addr-alloc-00" indexInclude="true" number="1897" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
