  <front>
    <title>テキストのメディアタイプにおける「charset」パラメーターの扱いに関するMIMEの更新</title>
    <seriesInfo name="RFC" value="6657" stream="IETF"/>
    <author fullname="A. Melnikov" initials="A." surname="Melnikov">
