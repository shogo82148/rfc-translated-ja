<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="std" docName="draft-hoffman-telnet-uri-05" indexInclude="true" number="4248" obsoletes="1738" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
