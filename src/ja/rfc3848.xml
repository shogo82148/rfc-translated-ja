<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="std" docName="draft-newman-esmtpsa-01" indexInclude="true" number="3848" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
