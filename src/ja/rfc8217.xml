<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="std" updates="3261, 3325, 3515, 3892, 4508, 5002, 5318, 5360, 5502" docName="draft-ietf-sipcore-name-addr-guidance-02" indexInclude="true" number="8217" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
