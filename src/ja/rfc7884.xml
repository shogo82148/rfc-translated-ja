  <front>
    <title>シームレス双方向フォワーディング検出（S-BFD）のターゲットディスクリミネーターを広告するためのOSPF拡張</title>
    <seriesInfo name="RFC" value="7884" stream="IETF"/>
    <author fullname="Carlos Pignataro" initials="C." surname="Pignataro">
      <organization showOnFrontPage="true">Cisco</organization>
