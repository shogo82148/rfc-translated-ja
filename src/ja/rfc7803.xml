  <front>
    <title>NETCONF Capability URNsレジストリーの登録ポリシーの変更</title>
    <seriesInfo name="RFC" value="7803" stream="IETF"/>
    <seriesInfo name="BCP" value="203" stream="IETF"/>
    <author fullname="Barry Leiba" initials="B." surname="Leiba">
