  <front>
    <title>イーサネット上のSNMP</title>
    <seriesInfo name="RFC" value="1089" stream="IETF"/>
    <author fullname="M. Schoffstall" initials="M." surname="Schoffstall">
      <organization showOnFrontPage="true">Rensselaer Polytechnic Institute</organization>
