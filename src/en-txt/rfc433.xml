            <td align="left" colspan="1" rowspan="1">Echo</td>
          </tr>
          <tr>
            <td align="left" colspan="1" rowspan="1">9</td>
            <td align="left" colspan="1" rowspan="1">Discard</td>
          </tr>
          <tr>
            <td align="left" colspan="1" rowspan="1">19</td>
            <td align="left" colspan="1" rowspan="1">Character Generator [e.g. TTYTST]</td>
          </tr>
          <tr>
            <td align="left" colspan="1" rowspan="1">65</td>
            <td align="left" colspan="1" rowspan="1">Speech Data Base @ ll-tx-2 (74)</td>
          </tr>
          <tr>
            <td align="left" colspan="1" rowspan="1">67</td>
            <td align="left" colspan="1" rowspan="1">Datacomputer @ cca (31)</td>
          </tr>
          <tr>
            <td align="left" colspan="1" rowspan="1">241</td>
            <td align="left" colspan="1" rowspan="1">NCP Measurement</td>
