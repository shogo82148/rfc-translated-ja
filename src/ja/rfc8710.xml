            <title>EST over secure CoAP (EST-coaps)</title>
            <author initials="P" surname="Stok" fullname="Peter van der Stok">
              <organization showOnFrontPage="true"/>
            </author>
            <author initials="P" surname="Kampanakis" fullname="Panos Kampanakis">
