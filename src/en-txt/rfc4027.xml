  <front>
    <title>Domain Name System Media Types</title>
    <seriesInfo name="RFC" value="4027" stream="IETF"/>
    <author fullname="S. Josefsson" initials="S." surname="Josefsson">
      <address/>
    </author>
    <date year="2005" month="April"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document registers the media types application/dns and text/dns
in accordance with RFC 2048.  The application/dns media type is used
to identify data on the detached Domain Name System (DNS) format
described in RFC 2540.  The text/dns media type is used to identify
master files as described in RFC 1035.</t>
    </abstract>
