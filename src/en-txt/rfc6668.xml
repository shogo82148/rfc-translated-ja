  <front>
    <title>SHA-2 Data Integrity Verification for the Secure Shell (SSH) Transport Layer Protocol</title>
    <seriesInfo name="RFC" value="6668" stream="IETF"/>
    <author fullname="D. Bider" initials="D." surname="Bider">
      <organization showOnFrontPage="true">Bitvise Limited</organization>
      <address/>
    </author>
    <author fullname="M. Baushke" initials="M." surname="Baushke">
      <organization showOnFrontPage="true">Juniper Networks, Inc.</organization>
      <address/>
    </author>
    <date year="2012" month="July"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This memo defines algorithm names and parameters for use in some of
the SHA-2 family of secure hash algorithms for data integrity
verification in the Secure Shell (SSH) protocol.  It also updates RFC
4253 by specifying a new <bcp14>RECOMMENDED</bcp14> data integrity algorithm.</t>
    </abstract>
