<?xml version='1.0' encoding='utf-8'?>
<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="std" docName="draft-ietf-fax-reporting-extensions-05" indexInclude="true" number="2530" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
