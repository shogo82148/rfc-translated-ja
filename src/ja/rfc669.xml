          </tr>
          <tr>
            <td align="left" colspan="1" rowspan="1">1と27の両方で新プロトコル（3）</td>
            <td align="right" colspan="1" rowspan="1">6</td>
            <td align="right" colspan="1" rowspan="1">16%</td>
          </tr>
          <tr>
            <td align="left" colspan="1" rowspan="1">1のみで新プロトコル（3）</td>
