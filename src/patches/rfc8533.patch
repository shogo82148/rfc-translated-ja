+           for every hop that the packet traverses.  If the
+           TTL is zero, the data packet will be discarded.";
+      }
+      leaf packet-size {
+        type uint32 {
+          range "64..10000";
+        }
+        default "64";
+        description
+          "Packet size of the Continuity Check message, in octets.
+           By default, the packet size is set to 64 octets.";
+      }
+    }
+    output {
