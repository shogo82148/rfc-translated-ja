  <front>
    <title>The &quot;create-form&quot; and &quot;edit-form&quot; Link Relations</title>
    <seriesInfo name="RFC" value="6861" stream="independent"/>
    <date year="2013" month="January"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">RFC 5988 standardized a means of indicating the relationships between
resources on the Web.  This specification defines link relation types
that may be used to express the relationships between a resource and
an input form for constructing data submissions.</t>
    </abstract>
