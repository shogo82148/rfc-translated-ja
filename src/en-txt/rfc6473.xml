  <front>
    <title>vCard KIND:application</title>
    <seriesInfo name="RFC" value="6473" stream="IETF"/>
    <author fullname="P. Saint-Andre" initials="P." surname="Saint-Andre">
      <organization showOnFrontPage="true">Cisco</organization>
      <address/>
