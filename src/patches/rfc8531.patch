+    leaf technology {
+      type identityref {
+        base technology-types;
+      }
+      description
+        "The technology.";
+    }
+    leaf md-name-string {
+
+      type leafref {
+        path "/domains/domain/md-name-string";
+      }
+      mandatory true;
+      description
+        "Indicate which MD the defect belongs to";
+    }
+    leaf ma-name-string {
+      type leafref {
