+    <section anchor="security-considerations" numbered="true" removeInRFC="false" toc="include" pn="section-7.0">
+      <name slugifiedName="name-security-considerations">Security Considerations</name>
+      <t indent="0" pn="section-7.0-1">IPv6 addressing documents do not have any direct impact on Internet
+infrastructure security.  Authentication of IPv6 packets is defined
+in <xref target="AUTH" format="default" sectionFormat="of" derivedContent="AUTH"/>.</t>
+    </section>
