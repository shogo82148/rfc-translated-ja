+]]></artwork>
+      </figure>
+      <figure align="left" suppress-title="false" pn="figure-3">
+        <name slugifiedName="name-file-contents-of-v-unsent-mail-cont">File contents of ^V[--UNSENT-MAIL-CONTROL--^V].MTP.1</name>
+        <artwork name="" type="" align="left" alt="" pn="section-unnumbered-4-3.1"><![CDATA[
++--------------------------------------------------+
+|FILE:<LINDA>^V[--UNSENT-MAIL-FILE--^V].MTP.1<CRLF>|
