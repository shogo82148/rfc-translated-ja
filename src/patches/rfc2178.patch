+          <dt pn="section-10.3-17.5">New state:</dt>
+          <dd pn="section-10.3-17.6">Down</dd>
+          <dt pn="section-10.3-17.7">Action:</dt>
+          <dd pn="section-10.3-17.8">The Link state retransmission list, Database summary
+list and Link state request list are cleared of
+LSAs.  Also, the Inactivity Timer is disabled.</dd>
+        </dl>
+        <dl newline="false" spacing="normal" indent="3" pn="section-10.3-18">
+          <dt pn="section-10.3-18.1">State(s):</dt>
+          <dd pn="section-10.3-18.2">Any state</dd>
+          <dt pn="section-10.3-18.3">Event:</dt>
