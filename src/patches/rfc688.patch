+    <title>Tentative Schedule for the New TELNET Implementation for the TIP</title>
     <seriesInfo name="RFC" value="688" stream="IETF"/>
+    <author fullname="David C. Walden" initials="D. C." surname="Walden">
+      <organization showOnFrontPage="true">BBN</organization>
+      <address/>
