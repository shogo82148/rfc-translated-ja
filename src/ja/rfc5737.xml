  <front>
    <title>文書用に予約されたIPv4アドレスブロック</title>
    <seriesInfo name="RFC" value="5737" stream="IETF"/>
    <author fullname="J. Arkko" initials="J." surname="Arkko">
      <organization showOnFrontPage="true">Ericsson</organization>
      <address/>
    </author>
    <author fullname="M. Cotton" initials="M." surname="Cotton">
      <organization showOnFrontPage="true">ICANN</organization>
      <address/>
    </author>
    <author fullname="L. Vegoda" initials="L." surname="Vegoda">
      <organization showOnFrontPage="true">ICANN</organization>
      <address/>
    </author>
    <date year="2010" month="January"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">3つのIPv4ユニキャストアドレスブロックが、仕様書やその他の文書の例で使用するために予約されています。この文書では、これらのブロックの使い方を説明します。</t>
    </abstract>
    <boilerplate>
      <section anchor="status-of-memo" numbered="false" removeInRFC="false" toc="exclude" pn="section-boilerplate.1">
