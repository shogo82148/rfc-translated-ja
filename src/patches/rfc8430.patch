+                   (<egress-interface> <IEEE_MAC_ADDRESS>) |
+                   <tunnel-encapsulation> | <tunnel-decapsulation> |
+                   <logical-tunnel> |
+                   <rib-name>
+
+<egress-interface> ::= <INTERFACE_IDENTIFIER>
+
+<nexthop-special> ::= <DISCARD> | <DISCARD_WITH_ERROR> |
