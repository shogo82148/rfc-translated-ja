+      <section anchor="group-nir" numbered="false" removeInRFC="false" toc="exclude" pn="section-7.9">
+        <name slugifiedName="name-nir">NIR</name>
+        <dl newline="false" spacing="compact" indent="3" pn="section-7.9-1">
+          <dt pn="section-7.9-1.1">Date template updated or checked:</dt>
