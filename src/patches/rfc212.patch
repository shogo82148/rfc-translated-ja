-    <title>NWG meeting on network usage</title>
+    <title>NWG Meeting On Network Usage</title>
     <seriesInfo name="RFC" value="212" stream="IETF"/>
-    <date year="1971" month="August"/>
+    <author>
+      <organization showOnFrontPage="true">NWG Steering Committee</organization>
