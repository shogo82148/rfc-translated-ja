  <front>
    <title>Internet Assigned Numbers Authority (IANA) Registration of Instant Messaging and Presence DNS SRV RRs for the Session Initiation Protocol (SIP)</title>
    <seriesInfo name="RFC" value="5509" stream="IETF"/>
    <author fullname="S. Loreto" initials="S." surname="Loreto">
      <organization showOnFrontPage="true">Ericsson</organization>
      <address/>
    </author>
    <date year="2009" month="April"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document registers with IANA two new DNS SRV protocol labels for
resolving Instant Messaging and Presence services with SIP.</t>
    </abstract>
