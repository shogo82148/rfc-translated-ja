  <front>
    <title>サブジェクト鍵識別子（SKI）によるSEND（SEcure Neighbor Discovery）のName Typeフィールド</title>
    <seriesInfo name="RFC" value="6495" stream="IETF"/>
    <author fullname="R. Gagliano" initials="R." surname="Gagliano">
      <organization showOnFrontPage="true">Cisco Systems</organization>
      <address/>
    </author>
    <author fullname="S. Krishnan" initials="S." surname="Krishnan">
      <organization showOnFrontPage="true">Ericsson</organization>
      <address/>
    </author>
    <author fullname="A. Kukec" initials="A." surname="Kukec">
      <organization showOnFrontPage="true">Enterprise Architects</organization>
      <address/>
    </author>
    <date year="2012" month="February"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">SEND（SEcure Neighbor Discovery）は、ICMPv6のトラストアンカー（Trust Anchor）オプションにName Typeフィールドを定義しています。この文書は、証明書のサブジェクト鍵識別子（SKI：Subject Key Identifier）に基づく新しいName Typeフィールドを規定します。</t>
    </abstract>
