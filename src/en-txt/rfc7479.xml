  <front>
    <title>Using Ed25519 in SSHFP Resource Records</title>
    <seriesInfo name="RFC" value="7479" stream="IETF"/>
    <date year="2015" month="March"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">The Ed25519 signature algorithm has been implemented in OpenSSH.
This document updates the IANA &quot;SSHFP RR Types for public key
algorithms&quot; registry by adding an algorithm number for Ed25519.</t>
    </abstract>
