+    <section anchor="nir-groups" numbered="true" removeInRFC="false" toc="include" pn="section-7">
+      <name slugifiedName="name-nir-groups">NIR Groups</name>
+      <t indent="0" pn="section-7-1">This section contains information about the various groups working in
+the area of networked information retrieval.  The groups are listed
+alphabetically within their overall groupings (CNI, IETF, RARE,
+etc.).  See Section 3.</t>
+      <section anchor="group-cni-groups" numbered="false" removeInRFC="false" toc="exclude" pn="section-7.1">
