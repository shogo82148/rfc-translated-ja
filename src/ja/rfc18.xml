  <front>
    <title>IMP-IMP および HOST-HOST 制御リンク</title>
    <seriesInfo name="RFC" value="18" stream="IETF"/>
    <author fullname="Vint Cerf" initials="V." surname="Cerf">
      <organization showOnFrontPage="true">University of California Los Angeles</organization>
      <address/>
    </author>
    <date year="1969" month="September"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">HOST-HOST 制御リンクにはリンク 1 を、IMP-IMP 制御にはリンク 0 を使うことを提案します。</t>
      <t indent="0" pn="section-abstract-2">こうすることで、ホスト間の通信が容易になり、IMP-IMP 通信との干渉による遅延が減ります。</t>
      <t indent="0" pn="section-abstract-3">[この RFC は Elmar K. Bins によってオンラインに復元されました]</t>
    </abstract>
  </front>
  <middle>
  </middle>
  <back>
  </back>
</rfc>
