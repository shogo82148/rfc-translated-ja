  <front>
    <title>Bit Index Explicit Replication (BIER) Support via IS-IS</title>
    <seriesInfo name="RFC" value="8401" stream="IETF"/>
    <date year="2018" month="June"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document defines IS-IS extensions to support multicast
forwarding using the Bit Index Explicit Replication (BIER)
architecture.</t>
    </abstract>
