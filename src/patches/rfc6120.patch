+      <dt pn="section-15-51.3">Description:</dt>
+      <dd pn="section-15-51.4">Bind an XML stream to a TCP connection.</dd>
+      <dt pn="section-15-51.5">Section:</dt>
+      <dd pn="section-15-51.6"><xref target="section-3" format="default" sectionFormat="of" derivedContent="Section 3"/></dd>
