<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" docName="draft-ietf-mpls-tp-loss-delay-profile-04" indexInclude="true" number="6375" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
