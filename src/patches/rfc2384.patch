-</t>
-      <t indent="0" pn="section-8-3"><artwork name="" type="" align="left" alt=""><![CDATA[
-     auth             = ";AUTH=" ( "*" / enc-auth-type )
-]]></artwork>
-</t>
-      <t indent="0" pn="section-8-4"><artwork name="" type="" align="left" alt=""><![CDATA[
-     enc-auth-type    = enc-sasl / enc-ext
-]]></artwork>
-</t>
-      <t indent="0" pn="section-8-5"><artwork name="" type="" align="left" alt=""><![CDATA[
-     enc-ext          = "+" ("APOP" / 1*achar)
-                           ;APOP or encoded extension mechanism name
-]]></artwork>
-</t>
-      <t indent="0" pn="section-8-6"><artwork name="" type="" align="left" alt=""><![CDATA[
-     enc-sasl         = 1*achar
-                           ;encoded version of [SASL] "auth_type"
-]]></artwork>
-</t>
-      <t indent="0" pn="section-8-7"><artwork name="" type="" align="left" alt=""><![CDATA[
-     enc-user         = 1*achar
-                           ;encoded version of [POP3] mailbox
-]]></artwork>
-</t>
-      <t indent="0" pn="section-8-8"><artwork name="" type="" align="left" alt=""><![CDATA[
-     pop-url          = "pop://" server
-]]></artwork>
-</t>
-      <t indent="0" pn="section-8-9"><artwork name="" type="" align="left" alt=""><![CDATA[
-     server           = [user-auth "@"] hostport
-                           ;See [BASIC-URL] for "hostport" definition
-]]></artwork>
-</t>
-      <t indent="0" pn="section-8-10"><artwork name="" type="" align="left" alt=""><![CDATA[
-     user-auth        = enc-user [auth]
-]]></artwork>
-</t>
+      <sourcecode type="abnf" markers="false" pn="section-8-2"><![CDATA[
+achar            = uchar / "&" / "=" / "~"
+                        ; see [BASIC-URL] for "uchar" definition
+
+auth             = ";AUTH=" ( "*" / enc-auth-type )
+
+enc-auth-type    = enc-sasl / enc-ext
+
+enc-ext          = "+" ("APOP" / 1*achar)
+                      ;APOP or encoded extension mechanism name
+
+enc-sasl         = 1*achar
+                      ;encoded version of [SASL] "auth_type"
+
+enc-user         = 1*achar
+                      ;encoded version of [POP3] mailbox
+
+pop-url          = "pop://" server
+
+server           = [user-auth "@"] hostport
+                      ;See [BASIC-URL] for "hostport" definition
+
+user-auth        = enc-user [auth]
+]]></sourcecode>
     </section>
