+      <t indent="0" pn="section-3-1">The grammar for the NAI is given below, described in ABNF as documented in <xref target="7" format="default" sectionFormat="of" derivedContent="7"/>.  The grammar for the username is taken from <xref target="5" format="default" sectionFormat="of" derivedContent="5"/>, and the grammar for the realm is an updated version of <xref target="4" format="default" sectionFormat="of" derivedContent="4"/>.</t>
+      <sourcecode type="abnf" markers="false" pn="section-3-2"><![CDATA[
+nai         = username / ( username "@" realm )
+username    = dot-string
+
+realm       = realm "." label
+
+label       = let-dig * (ldh-str)
+
+ldh-str     = *( Alpha / Digit / "-" ) let-dig
+
+dot-string  = string / ( dot-string "." string )
+
+string      = char / ( string char )
+
+char        = c / ( "\" x )
+
+let-dig     = Alpha / Digit
+
+Alpha       = %x41-5A / %x61-7A   ; A-Z / a-z
+
+Digit       = %x30-39  ;0-9
+
+c           = < any one of the 128 ASCII characters, but
+               not any special or SP >
+
+x           = %x00-7F
+              ; all 127 ASCII characters, no exception
+
+SP          = %x20 ; Space character
+
+special     = "<" / ">" / "(" / ")" / "[" / "]" / "\" / "."
+               / "," / ";" / ":" / "@" / %x22  / Ctl
+
+Ctl         = %x00-1F / %x7F
