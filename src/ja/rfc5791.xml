  <front>
    <title>RFC 2731（「Encoding Dublin Core Metadata in HTML」）の廃止</title>
    <seriesInfo name="RFC" value="5791" stream="IETF"/>
    <author fullname="J. Reschke" initials="J." surname="Reschke">
      <organization showOnFrontPage="true">greenbytes</organization>
      <address/>
    </author>
    <author fullname="J. Kunze" initials="J." surname="Kunze">
      <organization showOnFrontPage="true">University of California</organization>
      <address/>
    </author>
    <date year="2010" month="February"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">この仕様のさらなる開発はDublin Core Metadata Initiative（DCMI）に移ったため、この文書はRFC 2731「Encoding Dublin Core Metadata in HTML」を廃止します。</t>
    </abstract>
    <boilerplate>
      <section anchor="status-of-memo" numbered="false" removeInRFC="false" toc="exclude" pn="section-boilerplate.1">
