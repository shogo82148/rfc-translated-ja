-]]></artwork>
-</t>
-      <t indent="0" pn="section-6-88"> grouping operator-parameters {
-   description
-     &quot;This grouping defines parameters that can be changed by an
-      operator.&quot;;
-   leaf time {
-     type yang:date-and-time;
-     mandatory true;
-     description</t>
-      <t indent="0" pn="section-6-89"><artwork name="" type="" align="left" alt=""><![CDATA[
-       "Timestamp for operator action on the alarm.";
