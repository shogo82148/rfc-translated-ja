+                <th align="left" colspan="1" rowspan="1">bit 3</th>
+                <th align="left" colspan="1" rowspan="1">bit 2</th>
+                <th align="left" colspan="1" rowspan="1">bit 1</th>
+              </tr>
+            </thead>
+            <tbody>
+              <tr>
+                <td align="left" colspan="1" rowspan="1">expense metric</td>
+                <td align="left" colspan="1" rowspan="1">0</td>
+                <td align="left" colspan="1" rowspan="1">0</td>
+                <td align="left" colspan="1" rowspan="1">0</td>
+              </tr>
+              <tr>
+                <td align="left" colspan="1" rowspan="1">default metric</td>
+                <td align="left" colspan="1" rowspan="1">0</td>
+                <td align="left" colspan="1" rowspan="1">0</td>
+                <td align="left" colspan="1" rowspan="1">1</td>
+              </tr>
