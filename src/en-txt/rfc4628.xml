  <front>
    <title>RTP Payload Format for H.263 Moving RFC 2190 to Historic Status</title>
    <seriesInfo name="RFC" value="4628" stream="IETF"/>
    <author fullname="R. Even" initials="R." surname="Even">
      <organization showOnFrontPage="true">Polycom</organization>
      <address/>
    </author>
    <date year="2007" month="January"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">The first RFC that describes an RTP payload format for ITU
Telecommunication Standardization Sector (ITU-T) recommendation H.263
is RFC 2190.  This specification discusses why to move RFC 2190 to
historic status.</t>
    </abstract>
