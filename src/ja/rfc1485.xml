          <name slugifiedName="name-standardised-keywords">標準化されたキーワード</name>
          <thead>
            <tr>
              <th align="left" colspan="1" rowspan="1">キー</th>
              <th align="left" colspan="1" rowspan="1">属性（X.520のキー）</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td align="left" colspan="1" rowspan="1">CN</td>
              <td align="left" colspan="1" rowspan="1">CommonName</td>
            </tr>
            <tr>
              <td align="left" colspan="1" rowspan="1">L</td>
