  <front>
    <title abbrev="Legacy PKCS #1 Code Points for TLS 1.3">TLS 1.3 のためのレガシー RSASSA-PKCS1-v1_5 コードポイント</title>
    <seriesInfo name="RFC" value="9963" stream="IETF"/>
    <author initials="D." surname="Benjamin" fullname="David Benjamin">
