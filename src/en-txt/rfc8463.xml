    <section anchor="example-of-a-signed-message" numbered="true" removeInRFC="false" toc="include" pn="section-appendix.a">
      <name slugifiedName="name-example-of-a-signed-message">Example of a Signed Message</name>
      <t indent="0" pn="section-appendix.a-1">This is a small message with both RSA-SHA256 and Ed25519-SHA256 DKIM
signatures.  The signatures are independent of each other, so either
signature would be valid if the other were not present.</t>
      <section anchor="secret-keys" numbered="true" removeInRFC="false" toc="include" pn="section-a.1">
        <name slugifiedName="name-secret-keys">Secret Keys</name>
        <t indent="0" pn="section-a.1-1">Ed25519 secret key in base64.  This is the secret key from <xref target="RFC8032" section="7.1" format="default" sectionFormat="comma" derivedLink="https://www.rfc-editor.org/rfc/rfc8032#section-7.1" derivedContent="RFC8032"/>, Test 1, converted from hex to base64.</t>
        <artwork name="" type="" align="left" alt="" pn="section-a.1-2"><![CDATA[
nWGxne/9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A=
]]></artwork>
        <t indent="0" pn="section-a.1-3">RSA secret key in PEM format.</t>
