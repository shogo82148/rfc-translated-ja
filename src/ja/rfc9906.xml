    <title abbrev="MUST NOT DNSSEC with ECC-GOST">DNSSEC における ECC-GOST の使用の廃止</title>
    <seriesInfo name="RFC" value="9906" stream="IETF"/>
    <author initials="W." surname="Hardaker" fullname="Wes Hardaker">
