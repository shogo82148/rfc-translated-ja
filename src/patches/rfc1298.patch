     </abstract>
+    <note removeInRFC="false" pn="section-note.1">
+      <name slugifiedName="name-editors-note">Editor's Note</name>
+      <t indent="0" pn="section-note.1-1">As stated below and in reference <xref target="ref-5" format="default" sectionFormat="of" derivedContent="5"/>, it is strongly advised that for
