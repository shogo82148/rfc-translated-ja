            <td align="left" colspan="1" rowspan="1">IEEE 754 binary64, big endian, Typed Array</td>
          </tr>
          <tr>
            <td align="right" colspan="1" rowspan="1">83</td>
            <td align="left" colspan="1" rowspan="1">byte string</td>
