      <dl newline="false" spacing="normal" indent="3" pn="section-2-2">
        <dt pn="section-2-2.1">ERO:</dt>
        <dd pn="section-2-2.2">明示的経路オブジェクト（Explicit Route Object）</dd>
        <dt pn="section-2-2.3">PCC:</dt>
        <dd pn="section-2-2.4">パス計算クライアント（Path Computation Client）</dd>
        <dt pn="section-2-2.5">PCE:</dt>
        <dd pn="section-2-2.6">パス計算要素（Path Computation Element）</dd>
        <dt pn="section-2-2.7">PCEP:</dt>
        <dd pn="section-2-2.8">PCE通信プロトコル（PCE Communication Protocol）</dd>
        <dt pn="section-2-2.9">PST:</dt>
        <dd pn="section-2-2.10">パス設定タイプ（Path Setup Type）</dd>
        <dt pn="section-2-2.11">TLV:</dt>
