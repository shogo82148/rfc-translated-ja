   <front>
     <title>No High Link Numbers</title>
     <seriesInfo name="RFC" value="25" stream="IETF"/>
+    <author fullname="Steve Crocker" initials="S." surname="Crocker">
+      <organization showOnFrontPage="true">UCLA</organization>
+      <address/>
+    </author>
     <date year="1969" month="October"/>
     <abstract pn="section-abstract">
+      <t indent="0" pn="section-abstract-1">Because it may be desirable to reserve one or more link numbers for
+instrumentation purposes, and because 256 link numbers are many more
+than are needed, we suggest that no link number over 63 be used.  At
+UCLA, we will implement our tables to take advantage of this limitation.
+We also note that 32 may be even more realistic, but 64 is certainly
+sufficient.</t>
     </abstract>
