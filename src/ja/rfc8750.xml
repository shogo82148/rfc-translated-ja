+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+
    </artwork>
      </figure>
      <dl newline="true" spacing="normal" pn="section-4-3">
        <dt pn="section-4-3.1">Sequence Number:</dt>
        <dd pn="section-4-3.2">ESPパケットで運ばれる4バイトのシーケンス番号です。</dd>
