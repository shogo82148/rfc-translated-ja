  <front>
    <title>UUIDベースのDHCPv6一意識別子（DUID-UUID）の定義</title>
    <seriesInfo name="RFC" value="6355" stream="IETF"/>
    <author fullname="T. Narten" initials="T." surname="Narten">
      <organization showOnFrontPage="true">IBM</organization>
      <address/>
    </author>
    <author fullname="J. Johnson" initials="J." surname="Johnson">
      <organization showOnFrontPage="true">IBM</organization>
      <address/>
