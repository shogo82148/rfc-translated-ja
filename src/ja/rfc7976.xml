  <front>
    <title abbrev="Updates to P-Header Usage">セッション開始プロトコル（SIP）のリクエストおよびレスポンスにおけるプライベートヘッダー（P-Header）拡張の使用法の更新</title>
    <seriesInfo name="RFC" value="7976" stream="IETF"/>
    <author fullname="C. Holmberg" initials="C." surname="Holmberg">
      <organization showOnFrontPage="true">Ericsson</organization>
      <address/>
    </author>
    <author fullname="N. Biondic" initials="N." surname="Biondic">
      <organization showOnFrontPage="true">Ericsson</organization>
      <address/>
