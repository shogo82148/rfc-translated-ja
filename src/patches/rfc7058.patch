+    <mediaResourceResponse reason="Resource found" status="200"
+                           id="n3un93wd">
+        <response-session-info>
+            <session-id>z603G3yaUzM8</session-id>
+            <seq>9</seq>
+            <expires>3600</expires>
+            <media-server-address
+                              uri="sip:MediaServer@ms.example.com:5080">
