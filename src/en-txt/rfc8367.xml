  <front>
    <title>Wrongful Termination of Internet Protocol (IP) Packets</title>
    <seriesInfo name="RFC" value="8367" stream="independent"/>
    <author fullname="T. Mizrahi" initials="T." surname="Mizrahi">
      <organization showOnFrontPage="true">Marvell</organization>
      <address/>
    </author>
    <author fullname="J. Yallouz" initials="J." surname="Yallouz">
      <organization showOnFrontPage="true">Intel</organization>
      <address/>
    </author>
    <date year="2018" month="April" day="1"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">Routers and middleboxes terminate packets for various reasons.  In
some cases, these packets are wrongfully terminated.  This memo
describes some of the most common scenarios of wrongful termination
of Internet Protocol (IP) packets and presents recommendations for
mitigating them.</t>
    </abstract>
