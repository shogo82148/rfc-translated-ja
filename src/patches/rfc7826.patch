+            </tr>
+            <tr>
+              <td align="left" colspan="1" rowspan="1">Content-Type</td>
+              <td align="left" colspan="1" rowspan="1"><xref target="section-18.19" format="default" sectionFormat="of" derivedContent="Section 18.19"/></td>
+            </tr>
