+        <dt pn="section-unnumbered-2-3.13">timestamp =</dt>
+        <dd pn="section-unnumbered-2-3.14">a right-justified, 32-bit timestamp in milliseconds modulo
+24 hours from midnight UT.</dd>
+      </dl>
