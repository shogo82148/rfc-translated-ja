  <front>
    <title>鍵識別子の値を生成するための追加の方法</title>
    <seriesInfo name="RFC" value="7093" stream="independent"/>
    <author fullname="S. Turner" initials="S." surname="Turner">
      <organization showOnFrontPage="true">IECA</organization>
      <address/>
    </author>
    <author fullname="S. Kent" initials="S." surname="Kent">
      <organization showOnFrontPage="true">BBN</organization>
      <address/>
    </author>
    <author fullname="J. Manger" initials="J." surname="Manger">
      <organization showOnFrontPage="true">Telstra</organization>
      <address/>
    </author>
    <date year="2013" month="December"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">この文書は、AKI（Authority Key Identifier）とSKI（Subject Key Identifier）の証明書拡張で使用する鍵識別子（Key Identifier）の値を生成する方法の例を追加で規定します。</t>
    </abstract>
