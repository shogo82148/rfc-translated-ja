+    <section anchor="security-considerations" numbered="false" removeInRFC="false" toc="include" pn="section-appendix.a">
+      <name slugifiedName="name-security-considerations">Security Considerations</name>
+      <t indent="0" pn="section-appendix.a-1">This memo indicates vulnerabilities with all too-forgiving DNS
+clients.  It points out a correction that would eliminate the future
+potential of the problem.</t>
+    </section>
