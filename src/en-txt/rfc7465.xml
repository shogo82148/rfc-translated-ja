    <section anchor="rc4-cipher-suites" numbered="true" removeInRFC="false" toc="include" pn="section-appendix.a">
      <name slugifiedName="name-rc4-cipher-suites">RC4 Cipher Suites</name>
      <t indent="0" pn="section-appendix.a-1">The following cipher suites defined for TLS use RC4:</t>
      <ul bare="false" empty="false" indent="3" spacing="normal" pn="section-appendix.a-2">
        <li pn="section-appendix.a-2.1">TLS_RSA_EXPORT_WITH_RC4_40_MD5</li>
        <li pn="section-appendix.a-2.2">TLS_RSA_WITH_RC4_128_MD5</li>
        <li pn="section-appendix.a-2.3">TLS_RSA_WITH_RC4_128_SHA</li>
        <li pn="section-appendix.a-2.4">TLS_DH_anon_EXPORT_WITH_RC4_40_MD5</li>
        <li pn="section-appendix.a-2.5">TLS_DH_anon_WITH_RC4_128_MD5</li>
        <li pn="section-appendix.a-2.6">TLS_KRB5_WITH_RC4_128_SHA</li>
        <li pn="section-appendix.a-2.7">TLS_KRB5_WITH_RC4_128_MD5</li>
        <li pn="section-appendix.a-2.8">TLS_KRB5_EXPORT_WITH_RC4_40_SHA</li>
        <li pn="section-appendix.a-2.9">TLS_KRB5_EXPORT_WITH_RC4_40_MD5</li>
        <li pn="section-appendix.a-2.10">TLS_PSK_WITH_RC4_128_SHA</li>
        <li pn="section-appendix.a-2.11">TLS_DHE_PSK_WITH_RC4_128_SHA</li>
        <li pn="section-appendix.a-2.12">TLS_RSA_PSK_WITH_RC4_128_SHA</li>
        <li pn="section-appendix.a-2.13">TLS_ECDH_ECDSA_WITH_RC4_128_SHA</li>
        <li pn="section-appendix.a-2.14">TLS_ECDHE_ECDSA_WITH_RC4_128_SHA</li>
        <li pn="section-appendix.a-2.15">TLS_ECDH_RSA_WITH_RC4_128_SHA</li>
        <li pn="section-appendix.a-2.16">TLS_ECDHE_RSA_WITH_RC4_128_SHA</li>
        <li pn="section-appendix.a-2.17">TLS_ECDH_anon_WITH_RC4_128_SHA</li>
        <li pn="section-appendix.a-2.18">TLS_ECDHE_PSK_WITH_RC4_128_SHA</li>
      </ul>
