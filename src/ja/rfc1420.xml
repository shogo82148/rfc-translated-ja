  <front>
    <title>IPX上のSNMP</title>
    <seriesInfo name="RFC" value="1420" stream="IETF"/>
    <author fullname="Steve Bostock" initials="S." surname="Bostock">
      <organization showOnFrontPage="true">Novell, Inc.</organization>
      <address>
