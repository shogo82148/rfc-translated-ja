  <front>
    <title>The Profile URI Registry</title>
    <seriesInfo name="RFC" value="7284" stream="independent"/>
    <author fullname="Markus Lanthaler" initials="M." surname="Lanthaler">
      <address>
        <email>mail@markus-lanthaler.com</email>
        <uri>http://www.markus-lanthaler.com/</uri>
