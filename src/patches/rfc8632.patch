-   }
-   leaf last-changed {
-     type yang:date-and-time;
-     mandatory true;
-     description
-       &quot;A timestamp when the 'status-change' or
-        'operator-state-change' list was last changed.&quot;;
-   }
-   leaf perceived-severity {
-     type severity;
-     mandatory true;
-     description
-       &quot;The last severity of the alarm.</t>
-      <t indent="0" pn="section-6-91"><artwork name="" type="" align="left" alt=""><![CDATA[
-        If an alarm was raised with severity 'warning' but later
-        changed to 'major', this leaf will show 'major'.";
-   }
-   leaf alarm-text {
-     type alarm-text;
-     mandatory true;
-     description
