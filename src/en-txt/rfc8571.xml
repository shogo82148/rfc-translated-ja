          <thead>
            <tr>
              <th align="left" colspan="1" rowspan="1">Attribute Name</th>
              <th align="left" colspan="1" rowspan="1">IS-IS Sub-TLV</th>
              <th align="left" colspan="1" rowspan="1">OSPFv2/OSPFv3 Sub-TLV</th>
            </tr>
          </thead>
          <tbody>
