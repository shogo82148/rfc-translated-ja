<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" category="info" docName="draft-chon-korean-encoding-01" indexInclude="true" number="1557" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
