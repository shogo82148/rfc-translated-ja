<rfc xmlns:xi="http://www.w3.org/2001/XInclude" version="3" docName="draft-rfced-rfcxx00-retired-06" indexInclude="true" number="7101" symRefs="true" tocDepth="3" tocInclude="true" xml:lang="en">
