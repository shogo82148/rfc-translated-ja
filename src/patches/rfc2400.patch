       <section anchor="definitions-of-protocol-state" numbered="true" removeInRFC="false" toc="include" pn="section-4.1">
         <name slugifiedName="name-definitions-of-protocol-state">Definitions of Protocol State</name>
         <t indent="0" pn="section-4.1-1">Every protocol listed in this document is assigned to a &quot;maturity
 level&quot; or STATE of standardization: &quot;standard&quot;, &quot;draft standard&quot;,
 &quot;proposed standard&quot;, &quot;experimental&quot;, or &quot;historic&quot;.</t>
