  <front>
    <title>鍵付きMD5を用いたIP認証</title>
    <seriesInfo name="RFC" value="1828" stream="IETF"/>
    <author fullname="Perry Metzger" initials="P." surname="Metzger">
      <organization showOnFrontPage="true">Piermont</organization>
      <address/>
    </author>
    <author fullname="William Allen Simpson" initials="W. A." surname="Simpson">
      <organization showOnFrontPage="true">Daydreamer</organization>
      <address/>
    </author>
    <date year="1995" month="August"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">この文書では、IP認証ヘッダー（IP Authentication Header）での鍵付きMD5（keyed MD5）の使用について説明します。</t>
    </abstract>
