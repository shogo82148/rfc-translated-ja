          </tr>
          <tr>
            <td align="left" colspan="1" rowspan="1">NFC</td>
            <td align="left" colspan="1" rowspan="1"><xref target="IPv6-over-NFC" format="default" sectionFormat="of" derivedContent="IPv6-over-NFC"/></td>
