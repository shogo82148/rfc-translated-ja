  <front>
    <title>Authentication-Results Registration Update for Sender Policy Framework (SPF) Results</title>
    <seriesInfo name="RFC" value="6577" stream="IETF"/>
    <date year="2012" month="March"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This memo updates the registry of authentication method results in
Authentication-Results: message header fields, correcting a
discontinuity between the original registry creation and the Sender
Policy Framework (SPF) specification.</t>
      <t indent="0" pn="section-abstract-2">This memo updates RFC 5451.</t>
    </abstract>
