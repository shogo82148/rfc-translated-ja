  <front>
    <title>4オクテットAS固有のBGP拡張コミュニティー</title>
    <seriesInfo name="RFC" value="5668" stream="IETF"/>
    <author fullname="Y. Rekhter" initials="Y." surname="Rekhter">
      <organization showOnFrontPage="true">Juniper Networks</organization>
      <address/>
    </author>
    <author fullname="S. Sangli" initials="S." surname="Sangli">
      <organization showOnFrontPage="true">Cisco Systems</organization>
      <address/>
    </author>
    <author fullname="D. Tappan" initials="D." surname="Tappan">
      <organization showOnFrontPage="true">Consultant</organization>
      <address/>
    </author>
    <date year="2009" month="October"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">この文書は、4オクテットの自律システム（AS: Autonomous System）番号を運ぶ、新しいタイプのBGP拡張コミュニティーを定義します。</t>
    </abstract>
