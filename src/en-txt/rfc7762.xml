            </tr>
            <tr>
              <td align="left" colspan="1" rowspan="1">frame-src</td>
              <td align="left" colspan="1" rowspan="1"><xref target="CSP" format="default" sectionFormat="of" derivedContent="CSP"/></td>
            </tr>
            <tr>
              <td align="left" colspan="1" rowspan="1">img-src</td>
