  <front>
    <title>インターネットエクスチェンジのBGPルートサーバーの運用</title>
    <seriesInfo name="RFC" value="7948" stream="IETF"/>
    <author fullname="N. Hilliard" initials="N." surname="Hilliard">
      <organization showOnFrontPage="true">INEX</organization>
      <address/>
    </author>
    <author fullname="E. Jasinska" initials="E." surname="Jasinska">
