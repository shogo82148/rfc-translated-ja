  <front>
    <title>IP Payload Compression Using LZS</title>
    <seriesInfo name="RFC" value="2395" stream="IETF"/>
    <date year="1998" month="December"/>
    <abstract pn="section-abstract">
      <t indent="0" pn="section-abstract-1">This document describes a compression method based on the LZS
compression algorithm. This document defines the application of the
LZS algorithm to the IP Payload Compression Protocol <xref target="IPCOMP" format="default" sectionFormat="of" derivedContent="IPCOMP"/>.
<xref target="IPCOMP" format="default" sectionFormat="of" derivedContent="IPCOMP"/> defines a method for applying lossless compression to the
payloads of Internet Protocol datagrams.</t>
    </abstract>
