  <front>
    <title>Moving mailserver: URI Scheme to Historic</title>
    <seriesInfo name="RFC" value="6196" stream="IETF"/>
    <author fullname="A. Melnikov" initials="A." surname="Melnikov">
      <organization showOnFrontPage="true">Isode Limited</organization>
